{
  "name": "registro-ventas-solana-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cliente": "node scripts/generar-cliente.mjs",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test tests/*.test.ts",
    "configurar:idl": "node scripts/configurar-idl.mjs",
    "clase:dia3": "node scripts/preparar-clase.mjs dia3",
    "clase:dia4": "node scripts/preparar-clase.mjs dia4",
    "clase:resuelto": "node scripts/preparar-clase.mjs resuelto",
    "verificar": "npm run typecheck && npm test && npm run build",
    "comprobar:idl": "node scripts/verificar-contrato.mjs",
    "prebuild": "npm run comprobar:idl",
    "predev": "npm run comprobar:idl"
  },
  "dependencies": {
    "@solana/kit": "^8.6.0",
    "@solana/program-client-core": "8.6.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.8.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "codama": "^1.11.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
